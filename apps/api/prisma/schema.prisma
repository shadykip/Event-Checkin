datasource db {
  provider = "postgresql"
}

model Event {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  slug            String       @unique
  venue           String
  startsAt        DateTime     @map("starts_at") @db.Timestamptz(3)
  description     String?
  descriptionHtml String?      @map("description_html")
  banner          EventBanner?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  invitations         Invitation[]
  staffAssignments    EventStaffAssignment[]
  checkIn             CheckIn?               @relation(fields: [checkInInvitationId], references: [invitationId])
  checkInInvitationId String?                @db.Uuid

  ticketAllocation TicketAllocation?
  ticketTiers      TicketTier[]

  @@map("events")
}

model TicketTier {
  peoplePerTicket Int           @default(1) @map("people_per_ticket")
  id              String        @id @default(uuid()) @db.Uuid
  eventId         String        @map("event_id") @db.Uuid
  name            String
  nameKey         String        @map("name_key")
  priceMinor      Int           @map("price_minor")
  currency        String        @default("KES") @db.Char(3)
  capacity        Int
  salesStartAt    DateTime?     @map("sales_start_at") @db.Timestamptz(3)
  salesEndAt      DateTime?     @map("sales_end_at") @db.Timestamptz(3)
  archived        Boolean       @default(false)
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders          TicketOrder[]

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, nameKey])
  @@index([eventId, archived])
  @@map("ticket_tiers")
}

model TicketOrder {
  peoplePerTicket Int         @default(1) @map("people_per_ticket")
  id              String      @id @default(uuid()) @db.Uuid
  tierId          String      @map("tier_id") @db.Uuid
  checkoutKey     String      @map("checkout_key") @db.Uuid
  guestName       String      @map("guest_name")
  guestEmail      String      @map("guest_email")
  tierName        String      @map("tier_name")
  amountMinor     Int         @map("amount_minor")
  currency        String      @db.Char(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime    @map("expires_at") @db.Timestamptz(3)
  paidAt          DateTime?   @map("paid_at") @db.Timestamptz(3)
  checkoutUrl     String?     @map("checkout_url")
  paymentReview   String?     @map("payment_review")
  emailSentAt     DateTime?   @map("email_sent_at") @db.Timestamptz(3)
  invitationId    String?     @unique @map("invitation_id") @db.Uuid
  invitation      Invitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  tier TicketTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  paymentStartedAt DateTime? @map("payment_started_at") @db.Timestamptz(3)
  recoveryAfter    DateTime? @map("recovery_after") @db.Timestamptz(3)
  recoveryAttempts Int       @default(0) @map("recovery_attempts")
  recoveryLease    String?   @map("recovery_lease") @db.Uuid

  @@unique([tierId, checkoutKey])
  @@index([recoveryAfter, id])
  @@index([tierId, paidAt, expiresAt])
  @@map("ticket_orders")
}

model TicketAllocation {
  eventId  String @id @map("event_id") @db.Uuid
  capacity Int
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("ticket_allocations")
}

model EventBanner {
  eventId String @id @map("event_id") @db.Uuid
  image   Bytes
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_banners")
}

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  eventId    String    @map("event_id") @db.Uuid
  guestName  String    @map("guest_name")
  guestEmail String    @map("guest_email")
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  checkIns CheckIn[]

  rsvpStatus      RsvpStatus   @default(PENDING) @map("rsvp_status")
  rsvpRespondedAt DateTime?    @map("rsvp_responded_at") @db.Timestamptz(3)
  isPublicTicket  Boolean      @default(false) @map("is_public_ticket")
  ticketOrder     TicketOrder?

  @@unique([eventId, guestEmail])
  @@map("invitations")
}

model StaffAccount {
  id               String                 @id @default(uuid()) @db.Uuid
  name             String
  email            String                 @unique
  passwordHash     String                 @map("password_hash")
  isActive         Boolean                @default(true) @map("is_active")
  canCreateEvents  Boolean                @default(false) @map("can_create_events")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  assignments      EventStaffAssignment[]
  sessions         StaffSession[]
  checkIns         CheckIn[]
  admissionBatches AdmissionBatch[]

  resetTokenHash   String?   @unique @map("reset_token_hash") @db.Char(64)
  resetExpiresAt   DateTime? @map("reset_expires_at") @db.Timestamptz(3)
  resetRequestedAt DateTime? @map("reset_requested_at") @db.Timestamptz(3)

  @@map("staff_accounts")
}

model AdmissionBatch {
  invitationId  String   @map("invitation_id") @db.Uuid
  requestId     String   @map("request_id") @db.Uuid
  staffId       String   @map("staff_id") @db.Uuid
  quantity      Int
  admittedAfter Int      @map("admitted_after")
  checkedInAt   DateTime @default(now()) @map("checked_in_at") @db.Timestamptz(3)

  checkIn CheckIn      @relation(fields: [invitationId], references: [invitationId], onDelete: Restrict)
  staff   StaffAccount @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@id([invitationId, requestId])
  @@unique([invitationId, admittedAfter])
  @@map("admission_batches")
}

model CheckIn {
  invitationId String   @id @map("invitation_id") @db.Uuid
  staffId      String   @map("staff_id") @db.Uuid
  checkedInAt  DateTime @default(now()) @map("checked_in_at") @db.Timestamptz(3)

  invitation Invitation       @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  staff      StaffAccount     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  events     Event[]
  batches    AdmissionBatch[]

  @@index([staffId])
  @@map("check_ins")
}

enum EventStaffRole {
  DOOR_STAFF
  ORGANIZER
}

model EventStaffAssignment {
  eventId    String         @map("event_id") @db.Uuid
  staffId    String         @map("staff_id") @db.Uuid
  assignedAt DateTime       @default(now()) @map("assigned_at") @db.Timestamptz(3)
  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff      StaffAccount   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role       EventStaffRole @default(DOOR_STAFF)

  @@id([eventId, staffId])
  @@index([staffId])
  @@map("event_staff_assignments")
}

model StaffSession {
  tokenHash String       @id @map("token_hash") @db.Char(64)
  staffId   String       @map("staff_id") @db.Uuid
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  staff     StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_sessions")
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}
